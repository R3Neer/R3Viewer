* text=auto eol=lf
*.md text eol=lf
*.nu text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.png binary
*.pdf binary

# Fixed syntax resources retain the exact reviewed/package hash on checkout.
resources/syntax/toml/*.sublime-syntax -text
resources/syntax/toml/*.patch -text

# Vendored parser provenance is byte-exact.
vendor/jiter/** -text

vendor/saphyr-parser/** -text

# Synthetic origin-offset fixture requires byte-exact CRLF on every checkout.
tests/fixtures/markdown/wiki-unc-crlf.md -text whitespace=cr-at-eol

# Reviewed D2a preoutput manifests retain their exact bytes across platforms.
tests/fixtures/document-d2a/** -text whitespace=cr-at-eol

# Reviewed syntax role fixtures retain exact source offsets, including CRLF.
tests/fixtures/syntax-d4/** -text whitespace=cr-at-eol

# Code semantic fixtures retain reviewed bytes and CRLF offsets.
tests/fixtures/markdown-code/** -text whitespace=cr-at-eol

# Reviewed semantic search fixtures preserve exact source/model bytes.
tests/fixtures/document-b3-search/** -text whitespace=cr-at-eol
