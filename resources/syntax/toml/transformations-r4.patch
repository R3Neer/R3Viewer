@@ -1,3 +1,4 @@
+# Temporary R4: derived from R3; multiline continuation and 3..5 quote closures.
 %YAML 1.2
 ---
 # TEMP RV106 TOML1.1 derivative: optional seconds, e/x escapes, inline whitespace/comments/trailing comma.
@@ -166,7 +167,7 @@ contexts:
       scope: punctuation.definition.string.begin.toml
       set:
         - meta_scope: string.quoted.triple.literal.block.toml
-        - match: "'''"
