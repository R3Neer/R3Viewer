           scope: punctuation.definition.string.end.toml
           pop: true
     - match: '"""'
@@ -174,13 +175,23 @@ contexts:
       scope: punctuation.definition.string.begin.toml
       set:
         - meta_scope: string.quoted.triple.basic.block.toml
-        - match: '"""'
+        - match: '"{3,5}'
           scope: punctuation.definition.string.end.toml
           pop: true
+        - match: '\\[ \t]*\r?\n'
+          scope: constant.character.escape.toml
+          push: multiline-basic-continuation
         - include: string-escape
     - include: basic-string
     - include: literal-string
 
+  # R4: trim continued multiline basic whitespace; never enter from single-line strings.
+  multiline-basic-continuation:
+    - match: '[ \t\r\n]+'
+      scope: constant.character.escape.toml
+    - match: '(?=[^ \t\r\n])'
+      pop: true
+
   basic-string:
     - match: '"'
       scope: punctuation.definition.string.begin.toml
